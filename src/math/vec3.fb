mod tracer::math;

import tracer::math::{abs, min, sqrt};

pub struct Vec3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

impl Vec3 {
    pub func new(x: f32, y: f32, z: f32) Vec3 {
        return Vec3 { x: x, y: y, z: z };
    }

    pub func splat(val: f32) Vec3 {
        return Vec3 { x: val, y: val, z: val };
    }

    pub func length_squared(self) f32 {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }

    pub func length(self) f32 {
        return sqrt(self.length_squared());
    }

    pub func normalized(self) Vec3 {
        var length = self.length();

        return Vec3::new(
            self.x / length,
            self.y / length,
            self.z / length,
        );
    }

    pub func dot(self, v: Vec3) f32 {
        return self.x * v.x + self.y * v.y + self.z * v.z;
    }

    pub func cross(self, v: Vec3) Vec3 {
        return Vec3::new(
            self.y * v.z - self.z * v.y,
            self.z * v.x - self.x * v.z,
            self.x * v.y - self.y * v.x,
        );
    }

    pub func near_zero(self) bool {
        var s = 0.00000001f;
        return (abs(self.x) < s) && (abs(self.y) < s) && (abs(self.z) < s);
    }

    pub func reflect(self, normal: Vec3) Vec3 {
        return *self - normal * Vec3::splat(2.0f * self.dot(normal));
    }

    pub func refract(self, normal: Vec3, etai_over_etat: f32) Vec3 {
        var cos_theta = min((*self * Vec3::splat(-1.0f)).dot(normal), 1.0f);
        var r_out_perp =  (*self + normal * Vec3::splat(cos_theta)) * Vec3::splat(etai_over_etat);
        var r_out_parallel = normal * Vec3::splat(-sqrt(abs(1.0f - r_out_perp.length_squared())));
        return r_out_perp + r_out_parallel;
    }
}

impl Vec3 : Neg {
    type Result = Vec3;

    pub func neg(self) Vec3 {
        return Vec3::new(-self.x, -self.y, -self.z);
    }
}

impl Vec3 : Add[Vec3] {
    type Result = Vec3;

    pub func add(self, rhs: Vec3) Vec3 {
        return Vec3::new(self.x + rhs.x, self.y + rhs.y, self.z + rhs.z);
    }
}

impl Vec3 : Sub[Vec3] {
    type Result = Vec3;

    pub func sub(self, rhs: Vec3) Vec3 {
        return Vec3::new(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z);
    }
}

impl Vec3 : Mul[Vec3] {
    type Result = Vec3;

    pub func mul(self, rhs: Vec3) Vec3 {
        return Vec3::new(self.x * rhs.x, self.y * rhs.y, self.z * rhs.z);
    }
}

impl Vec3 : Div[Vec3] {
    type Result = Vec3;

    pub func div(self, rhs: Vec3) Vec3 {
        return Vec3::new(self.x / rhs.x, self.y / rhs.y, self.z / rhs.z);
    }
}

impl Vec3 : Rem[Vec3] {
    type Result = Vec3;

    pub func rem(self, rhs: Vec3) Vec3 {
        return Vec3::new(self.x % rhs.x, self.y % rhs.y, self.z % rhs.z);
    }
}
