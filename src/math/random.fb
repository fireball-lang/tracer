mod tracer::math;

import tracer::math::{Vec3, sqrt, cos, log, sign, max};

pub func random(state: mut *u32) f32 {
    var s = *state * 747796405u + 2891336453u;
    *state = s;

    var result = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    result = (result >> 22u) ^ result;

    return (result as f32) / 4294967295.0f;
}

pub func random_normal_distribution(state: mut *u32) f32 {
    var theta = 2.0f * 3.1415926f * random(state);
    var rho = sqrt(-2.0f * log(max(random(state), 0.00001f)));
    return rho * cos(theta);
}

pub func random_direction(state: mut *u32) Vec3 {
    var x = random_normal_distribution(state);
    var y = random_normal_distribution(state);
    var z = random_normal_distribution(state);

    return Vec3::new(x, y, z).normalized();
}

pub func random_hemisphere_direction(state: mut *u32, normal: Vec3) Vec3 {
    var dir = random_direction(state);
    var s = sign(normal.dot(dir));

    return Vec3::new(
        dir.x * s,
        dir.y * s,
        dir.z * s,
    );
}
