mod tracer::math;

import tracer::math::{Vec3, sqrt, cos, log, sign, max};
import std::rand::{Xoshiro256ss};

pub func random_normal_distribution(rng: mut &Xoshiro256ss) f32 {
    var theta = 2.0f * 3.1415926f * rng.next_f64() as f32;
    var rho = sqrt(-2.0f * log(max(rng.next_f64() as f32, 0.00001f)));
    return rho * cos(theta);
}

pub func random_direction(rng: mut &Xoshiro256ss) Vec3 {
    var x = random_normal_distribution(rng);
    var y = random_normal_distribution(rng);
    var z = random_normal_distribution(rng);

    return Vec3::new(x, y, z).normalized();
}

pub func random_hemisphere_direction(rng: mut &Xoshiro256ss, normal: Vec3) Vec3 {
    var dir = random_direction(rng);
    var s = sign(normal.dot(dir));

    return Vec3::new(
        dir.x * s,
        dir.y * s,
        dir.z * s,
    );
}
