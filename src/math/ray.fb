mod tracer::math;

import tracer::math::{Vec3};

struct Ray {
    origin: Vec3,
    direction: Vec3,
}

impl Ray {
    func new(origin: Vec3, direction: Vec3) Ray {
        var ray: Ray;

        ray.origin = origin;
        ray.direction = direction.normalized();

        return ray;
    }

    func at(self, t: f32) Vec3 {
        return self.origin.add(self.direction.mul(Vec3::splat(t)));
    }
}
