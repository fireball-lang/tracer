mod tracer::math;

import tracer::math::{Vec3};

pub struct Ray {
    pub origin: Vec3,
    pub direction: Vec3,
}

impl Ray {
    pub func new(origin: Vec3, direction: Vec3) Ray {
        var ray: Ray;

        ray.origin = origin;
        ray.direction = direction.normalized();

        return ray;
    }

    pub func at(self, t: f32) Vec3 {
        return self.origin.add(self.direction.mul(Vec3::splat(t)));
    }
}
