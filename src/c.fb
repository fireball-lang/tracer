mod tracer::c;

// STDIO

#[extern]
pub func printf(fmt: *u8, ...) void

// Memory

#[extern]
pub func malloc(size: u64) *mut void

#[extern]
pub func free(ptr: *void) void

#[extern]
pub func memcpy(dst: *void, src: *void, size: u64) *void

// File IO

struct File {}

#[extern, link_name("fopen")]
func _fopen(path: *u8, mode: *u8) *File

pub func fopen(path: StringView, mode: StringView) *File {
    return _fopen(path.ptr, mode.ptr);
}

#[extern]
pub func fwrite(data: *void, size: u64, count: u64, file: *File) u64

#[extern]
pub func fclose(file: *File) i32

// Time

pub struct Timespec {
    pub seconds: i64,
    pub nanoseconds: i64,
}

#[extern]
pub func timespec_get(ts: *mut Timespec, base: i32) i32
