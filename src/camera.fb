mod tracer;

import tracer::math::{Ray, Vec3, deg_to_rad, tan};

pub struct Camera {
    origin: Vec3,
    lower_left_corner: Vec3,
    horizontal: Vec3,
    vertical: Vec3,
}

impl Camera {
    pub func new(position: Vec3, look_at: Vec3, fov: f32, aspect_ratio: f32) Camera {
        var theta = deg_to_rad(fov);
        var h = tan(theta / 2.0f);
        var viewport_height = 2.0f * h;
        var viewport_width = aspect_ratio * viewport_height;

        var w = (position - look_at).normalized();
        var u = Vec3::new(0, 1, 0).cross(w).normalized();
        var v = w.cross(u);

        var horizontal = u * Vec3::splat(viewport_width);
        var vertical = v * Vec3::splat(viewport_height);

        return Camera {
            origin: position,
            horizontal: horizontal,
            vertical: vertical,
            lower_left_corner: (position - horizontal / Vec3::splat(2)) - (vertical / Vec3::splat(2)) - w,
        };
    }

    pub func get_ray(self, u: f32, v: f32) Ray {
        return Ray::new(self.origin, self.lower_left_corner + self.horizontal * Vec3::splat(u) + self.vertical * Vec3::splat(v) - self.origin);
    }
}
