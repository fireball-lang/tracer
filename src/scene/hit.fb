mod tracer::scene;

import tracer::scene::{Material};
import tracer::math::{Ray, Vec3};

pub struct Hit {
    pub point: Vec3,
    pub normal: Vec3,
    pub material: Material,
    pub t: f32,
    pub front_face: bool,
}

impl Hit {
    pub func set_face_normal(mut self, ray: Ray, outward_normal: Vec3) {
        self.front_face = ray.direction.dot(outward_normal) < 0.0f;

        if (self.front_face) self.normal = outward_normal;
        else self.normal = outward_normal * Vec3::splat(-1.0f);
    }
}
