mod tracer;

import tracer::scene::{Hit, Scene, Sphere, Lambertian, Metal, Dielectric};
import tracer::math::{Ray, Vec3, random, linear_to_gamma, clamp};
import tracer::{Camera};

import std::fmt::{Formatter};
import std::time::{Instant};
import std::os::{stdout};

import image::{Image, RGB8};

func create_scene() mut &Scene {
    var scene = Scene::new();

    // Ground
    scene.add(Sphere::new(
        Vec3::new(0.0f, -100.5f, -1.0f),
        100.0f,
        Lambertian::new(Vec3::new(0.8f, 0.8f, 0.0f)),
    ));

    // Center
    scene.add(Sphere::new(
        Vec3::new(0.0f, 0.0f, -1.2f),
        0.5f,
        Lambertian::new(Vec3::new(0.1f, 0.2f, 0.5f)),
    ));

    // Left
    scene.add(Sphere::new(
        Vec3::new(-1.0f, 0.0f, -1.0f),
        0.5f,
        Dielectric::new(1.5f),
    ));

    scene.add(Sphere::new(
        Vec3::new(-1.0f, 0.0f, -1.0f),
        0.4f,
        Dielectric::new(1.0f / 1.5f),
    ));

    // Right
    scene.add(Sphere::new(
        Vec3::new(1.0f, 0.0f, -1.0f),
        0.5f,
        Metal::new(Vec3::new(0.8f, 0.6f, 0.2f), 1.0f),
    ));

    return scene;
}

func main() {
    var image = Image:[RGB8]::new(1280u, 720u);

    var camera = Camera::new(
        Vec3::new(-2, 2, 1),
        Vec3::new(0, 0, -1),
        50,
        (image.width() as f32) / (image.height() as f32),
    );

    var scene = create_scene();

    var samples = 16;
    var depth = 6;

    var rng = 564961u;

    var start = Instant::now();

    for (var y = 0u; y < image.height(); y++) {
        for (var x = 0u; x < image.width(); x++) {
            var color: Vec3;

            for (var i = 0; i < samples; i++) {
                var u = (x as f32 + random(&rng)) / (image.width() as f32 - 1.0f);
                var v = 1.0f - (y as f32 + random(&rng)) / (image.height() as f32 - 1.0f);

                var ray = camera.get_ray(u, v);
                var sample_color = ray_color(&rng, ray, scene, depth);

                color = color.add(sample_color);
            }

            set(&image, x, y, color / Vec3::splat(samples as f32));
        }
    }

    print_elapsed(start);

    image.write_to("image.qoi");
    image.free();
}

func ray_color(rng: mut &u32, ray: Ray, scene: &Scene, depth: i32) Vec3 {
    if (depth <= 0) {
        return Vec3::splat(0);
    }

    var result = scene.hit(ray, 0.001f, 999999.0f);

    if (result.is_some()) {
        var hit = result.unwrap();

        var attenuation: Vec3;
        var scattered: Ray;

        if (hit.material.scatter(rng, ray, hit, &attenuation, &scattered)) {
            return attenuation * ray_color(rng, scattered, scene, depth - 1);
        }

        return Vec3::splat(0);
    }

    var a = 0.5f * (ray.direction.y + 1.0f);
    return Vec3::splat(1.0f - a) + Vec3::new(0.5f, 0.7f, 1.0f) * Vec3::splat(a);
}

pub func set(img: mut &Image[RGB8], x: u32, y: u32, color: Vec3) {
    var r = linear_to_gamma(color.x);
    var g = linear_to_gamma(color.y);
    var b = linear_to_gamma(color.z);

    img[x, y] = RGB8 {
        r: (256.0f * clamp(r, 0.0f, 0.999f)) as u8,
        g: (256.0f * clamp(g, 0.0f, 0.999f)) as u8,
        b: (256.0f * clamp(b, 0.0f, 0.999f)) as u8,
    };
}

func print_elapsed(start: Instant) {
    var fmt = Formatter::new(stdout());

    fmt.str("Rendered in ");
    start.elapsed().display(fmt);
    fmt.str("\n");
}
